        // 获取所有数据（支持按关键词拉取全部分页）
        async function fetchAllData(keyword = '') {
            if (!keyword && allItems.length > 0) {
                return allItems;
            }

            const allData = [];
            let page = 1;
            let hasMore = true;

            while (hasMore) {
                const params = new URLSearchParams({
                    page: String(page),
                    page_size: '100',
                    
                });

                if (keyword) {
                    params.append('keyword', keyword);
                }

                const response = await fetchWithTimeout(`${API_BASE_URL}?${params.toString()}`);
                if (!response.ok) {
                    throw new Error(`HTTP ${response.status}`);
                }

                const data = await response.json();
                if (data.code !== 200) {
                    throw new Error(data.message || '接口返回错误');
                }

                const result = data && data.result ? data.result : {};
                const items = result.items || [];
                if (items.length > 0) {
                    allData.push(...items);
                }

                const total = result.total || allData.length;
                if (items.length === 0 || allData.length >= total) {
                    hasMore = false;
                } else {
                    page += 1;
                }
            }

            if (!keyword) {
                allItems = allData;
            }

            return allData;
        }

       
        // 将数据转换为CSV格式
        function convertToCSV(items) {
            const headers = ['ID', '回答耗时', '提问时间', '问题', '答案'];
            const csvRows = [headers.join(',')];
            
            items.forEach(item => {
                const row = [
                    item.id,
                    `"${formatAnswerDuration(item.answer_duration_seconds)}"`,
                    `"${formatRecordTime(item.create_time)}"`,
                    `"${escapeCSV(item.question)}"`,
                    `"${escapeCSV(item.answer)}"`
                ];
                csvRows.push(row.join(','));
            });
            
            return csvRows.join('\n');
        }
        
        // 转义CSV中的特殊字符
        function escapeCSV(str) {
            if (!str) return '';
            // 转义双引号，并在包含逗号、换行或双引号时用双引号包围
            return str.replace(/"/g, '""');
        }
        
        // 下载CSV文件
        function downloadCSV(csvContent, filename) {
            const blob = new Blob(['\uFEFF' + csvContent], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const link = document.createElement('a');
            link.setAttribute('href', url);
            link.setAttribute('download', filename);
            link.style.visibility = 'hidden';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }
        
        // 获取当前日期时间字符串
        function getCurrentDateTime() {
            const now = new Date();
            return formatDateTimeParts(now).join('').replace(' ', '_').replace(/:/g, '-');
        }
        
        // HTML 转义函数
        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
