    </style>
</head>
<body>
    <div class="container">
        <header>
            <h1>唐山数字人2.0问答记录查询与分析</h1>
            <p class="description">查看数字人一体机的问答记录并进行数据分析</p>
        </header>
        
        <!-- 统计面板 -->
