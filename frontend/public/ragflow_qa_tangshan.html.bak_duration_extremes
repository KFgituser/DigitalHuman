    <script>
        // 设置基础的 API URL 和认证信息
        const DEFAULT_API_BASE_URL = "http://10.168.1.101:34001/knowledge/query/records";
        const API_BASE_URL =
            new URLSearchParams(window.location.search).get('api') ||
            window.localStorage.getItem('ragflowQaTangshanApi') ||
            DEFAULT_API_BASE_URL;
        const REQUEST_TIMEOUT_MS = 10000;
        const PAGE_SIZE = 10;
        
        // 当前页码和总页数
        let currentPage = 1;
        let totalPages = 1;
        let totalItems = 0;
        let currentItems = [];
        let allItems = []; // 存储所有数据用于搜索过滤
        let searchKeyword = '';
        let isSearching = false;
        let filteredItems = [];
        let allAnalysisData = []; // 存储所有数据用于分析
        let currentCategory = ''; // 当前筛选的分类：'answered', 'unanswered', 'unclearQuestion'
        let categoryItems = []; // 当前分类筛选后的数据

        // DOM 元素
        const loadingElement = document.getElementById('loading');
        const searchLoadingElement = document.getElementById('searchLoading');
        const errorElement = document.getElementById('error');
        const qaListElement = document.getElementById('qaList');
        const paginationElement = document.getElementById('pagination');
        const prevPageButton = document.getElementById('prevPage');
        const nextPageButton = document.getElementById('nextPage');
        const pageNumbersElement = document.getElementById('pageNumbers');
        const jumpPageInput = document.getElementById('jumpPage');
        const jumpButton = document.getElementById('jumpButton');
        const statsElement = document.getElementById('stats');
        const downloadCurrentButton = document.getElementById('downloadCurrent');
        const downloadAllButton = document.getElementById('downloadAll');
        const searchInput = document.getElementById('searchInput');
        const searchBtn = document.getElementById('searchBtn');
        const clearSearchBtn = document.getElementById('clearSearch');
        const searchInfo = document.getElementById('searchInfo');
        const searchKeywordElement = document.getElementById('searchKeyword');
        const searchResultsCountElement = document.getElementById('searchResultsCount');
        const categoryFilterElement = document.getElementById('categoryFilter');
        const categoryNameElement = document.getElementById('categoryName');
        const clearCategoryFilterBtn = document.getElementById('clearCategoryFilter');

        // 图表实例
        let ratioChart = null;
        let trendChart = null;

        // 请求控制与防抖
        const LOAD_DEBOUNCE_MS = 200;
        let loadDebounceTimer = null;
        let loadAbortController = null;
        let activeRequestId = 0;

        function fetchWithTimeout(resource, options = {}) {
            const controller = new AbortController();
            const timeoutId = window.setTimeout(() => controller.abort(), REQUEST_TIMEOUT_MS);
            const mergedOptions = { ...options, signal: controller.signal };

            if (options.signal) {
                if (options.signal.aborted) {
                    controller.abort();
                } else {
                    options.signal.addEventListener('abort', () => controller.abort(), { once: true });
                }
            }

            return fetch(resource, mergedOptions).finally(() => {
                window.clearTimeout(timeoutId);
            });
        }

        function buildLoadErrorMessage(error) {
            const message = error && error.message ? error.message : '未知错误';
            const isTimeout = error && error.name === 'AbortError';
            const diagnostics = [];

            diagnostics.push(isTimeout
                ? `接口请求超时（>${REQUEST_TIMEOUT_MS / 1000}秒）`
                : `加载失败: ${message}`);

            diagnostics.push(`接口地址: ${API_BASE_URL}`);

            if (window.location.protocol === 'https:' && API_BASE_URL.startsWith('http://')) {
                diagnostics.push('当前页面是 HTTPS，但接口是 HTTP，浏览器可能会拦截混合内容');
            }

            diagnostics.push('请确认当前电脑已连入对应内网，且该接口地址可以直接访问');
            return diagnostics.join('；');
        }

        function scheduleLoad(page = 1, keyword = '', category = '') {
            clearTimeout(loadDebounceTimer);
            loadDebounceTimer = setTimeout(() => {
                loadQAData(page, keyword, category);
            }, LOAD_DEBOUNCE_MS);
        }

        function createAbortError() {
            const error = new Error('Request aborted');
            error.name = 'AbortError';
            return error;
        }
        
        // 获取分类名称
        function getCategoryName(category) {
            switch(category) {
                case 'answered':
                    return '已回答';
                case 'unanswered':
                    return '未回答';
                case 'unclearQuestion':
                    return '提问不清晰';
                default:
                    return '';
            }
        }
        
        async function loadQAData(page = 1, keyword = '', category = '') {
            const requestId = ++activeRequestId;

            try {
                loadingElement.style.display = 'block';
