# Copying this file to .env is not enough: use scripts/Initialize-DeploymentEnv.ps1
# to create random secrets and choose the initial administrator account.
MYSQL_DATABASE=digitalhuman
MYSQL_APP_USERNAME=digitalhuman
DB_PASSWORD=replace-with-a-strong-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-password
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
INIT_ADMIN_ENABLED=true
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=replace-with-the-initial-admin-password
HOST_PORT=80
